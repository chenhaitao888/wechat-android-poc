# Replace the domain and certificate paths with the company's assigned values.
# The upstream backend, Hermes and MCP all remain on 127.0.0.1.
server {
    listen 443 ssl;
    server_name channel-bot.example.com;
    ssl_certificate /etc/nginx/wechat-channel/fullchain.pem;
    ssl_certificate_key /etc/nginx/wechat-channel/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8660;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
