[Unit]
Description=WeChat channel read-only mock business tools
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=CHANGE_ME_HERMES_USER
WorkingDirectory=/opt/wechat-android-poc/backend
Environment=CHANNEL_DATA_DIR=/var/lib/wechat-channel
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/wechat-android-poc/backend/.venv/bin/python -m channel_backend.mcp_server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/wechat-channel

[Install]
WantedBy=multi-user.target
