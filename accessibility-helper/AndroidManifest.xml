<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.wechat.accessibilityhelper" android:versionCode="1" android:versionName="0.1-test">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="31" />
    <application android:label="微信控件辅助" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".TouchModeService" android:label="微信控件辅助" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
